    "kinds": [
      "PDH",
      "PDL",
      "PWH",
      "PWL",
      "PMH",
      "PML"
    ],
    "zone_half": 0.0015,
    "touch_number": 1,
    "eligibility": "feature_eligible"
  },
  "barriers": {
    "x": "0.5 * 1.2816 * sigma * sqrt(48)",
    "sigma": "sigma_before_touch (288 5m log returns ending at bar j-1, ddof=1)",
    "p_up": "zone_high * (1 + x)",
    "p_dn": "zone_low * (1 - x)"
  },
  "outcome": {
    "rule_id": "LEVEL_RACE_4H_V1",
    "classify": "level_touch_degradation_v1.outcomes.classify",
    "bars": "j+1..j+48",
    "classes": [
      "BREAK",
      "REJECT",
      "NEITHER"
    ],
    "ambiguous": "excluded_and_counted"
  },
  "landmarks": {
    "T0": {
      "position": "close[j]",
      "tau_bars": 48,
      "population": "all eligible first touches"
    },
    "T15": {
      "position": "close[j+2]",
      "tau_bars": 45,
      "population": "no barrier hit on j+1, j+2"
    }
  },
  "prob_floor": 0.001,
  "b0": {
    "form": "driftless BM in log price, two absorbing barriers, sine series",
    "terms_until": 1e-15,
    "max_terms": 20000,
    "out_of_corridor": "1 - 2*eps on the crossed side",
    "test_seed": 20261008,
    "drift": 0.0,
    "discretisation": "continuous monitoring (5m high/low are true intrabar extremes); no Broadie-Glasserman shift"
  },
  "menu": {
    "B0": {
      "params": 0
    },
    "B1": {
      "cells": "family x STRUCT_SIDE per landmark",
      "smoothing": "Dirichlet(1,1,1)",
      "open_question": "Q1"
    },
    "M1": {
      "heads": {
        "R": [
          "1",
          "T15",
          "FAM_WM",
          "SIDE",
          "SIGMA_T"
