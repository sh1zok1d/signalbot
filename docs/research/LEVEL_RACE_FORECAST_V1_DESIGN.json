    "requires": "freeze commit + explicit mini-head go",
    "exposure_class": "TIME_DISJOINT_EXPOSED_SURFACE_REPLICATION-like (class B), not pristine",
    "parity_preflight": "2024 events from product 5m vs CORE 1m->5m, outcome-blind",
