  "ece": "descriptive only",
  "calibrator": {
    "form": "per head (R, B) logit p' = a + b logit p, Gaussian prior, MAP",
    "batch": "weekly",
    "heldout_prior": {
      "a": [
        0,
        0.5
      ],
      "b": [
