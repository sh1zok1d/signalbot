      "2026-08-25T17:20:00Z"
    ],
    "object_gap": [
      "2026-08-16T00:00:00Z",
      "2026-08-26T00:00:00Z"
    ],
    "event_exclusion": "span (j-289 .. j+48) intersects the object gap; constructor drops incomplete source/active periods",
