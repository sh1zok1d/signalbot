  "rng_authority": {
    "root_seed": 20260908,
    "world_identity": "HARNESS_SYNTHETIC_EDGE_CALIBRATION_V1|scenario|N|world_index",
    "world_index_zero_based": true,
    "seed_material": "root_seed_decimal + '|' + identity_string",
    "hash": "SHA256",
    "digest_slice": "first_8_raw_bytes",
    "byte_order": "big",
    "signed": false,
    "python_hash_forbidden": true,
    "separate_namespaces_for_bootstrap_placebo": true
  },
  "candidate_library": {
    "F01": "A",
    "F02": "B",
    "F03": "A*B",
    "F04": "1-A",
    "F05": "1-B",
    "F06": "XOR(A,B)",
    "F07": "I(X1>0)",
    "F08": "I(X2>0)",
    "F09": "I(X1>1)",
    "F10": "I(X2<-1)",
