  },
  "modes": {
    "ORACLE_CONFIRMATORY": {
      "candidate": "F03",
      "question": "given the correct formulation, can the strict confirmatory gate detect the injected incremental edge"
    },
    "BLIND_LIBRARY_DISCOVERY": {
      "candidate_count": 12,
      "generic_feature_ids": true,
      "question": "within a bounded preregistered library, can the process identify the true sparse conditional mechanism without selecting placebo structure"
    }
  },
  "primary_estimand": "P(DETECT | scenario, support, injected_effect, sample_size, noise_profile)",
  "sample_sizes": {
    "primary_N": 5000,
    "small_sensitivity_N": [2500, 10000],
    "eras": 5,
    "scored_eras": ["E2", "E3", "E4", "E5"]
  },
  "dgp": {
    "dtype": "float64",
    "rng": "numpy.random.Generator(numpy.random.PCG64(seed_int))",
    "baseline": {
      "X1": "X1_t = 0.70*X1_(t-1) + sqrt(1-0.70^2)*U1_t; U1~N(0,1); X1_0=0",
      "X2": "X2_t = 0.40*X2_(t-1) + sqrt(1-0.40^2)*U2_t; U2~N(0,1); X2_0=0",
      "MU_BASE": "0.20*X1_t - 0.15*X2_t"
    },
    "mechanism": {
      "A": "Bernoulli(q)",
      "B": "Bernoulli(q)",
      "q": "sqrt(target_support)",
      "TRUE_TRIGGER": "A*B",
      "single_components_have_injected_edge": false
    },
    "noise": {
      "RAW": "StudentT(df=5)/sqrt(5/3)",
      "ETA": "ETA_t = 0.25*ETA_(t-1) + sqrt(1-0.25^2)*RAW_t; ETA_0=0",
      "SIGMA": "1.0 + 0.30*abs(X1_t)",
      "NOISE": "SIGMA_t*ETA_t"
    },
    "outcome": "Y_t = MU_BASE_t + beta*TRUE_TRIGGER_t + NOISE_t",
    "positive_sign_frozen": true
  },
  "scenarios": [
    {"id": "NULL", "target_support": 0.10, "beta": 0.00, "role": "false_positive_control"},
    {"id": "EASY", "target_support": 0.20, "beta": 0.40, "role": "sanity_power"},
    {"id": "MODERATE", "target_support": 0.10, "beta": 0.25, "role": "ordinary_conditional_edge"},
    {"id": "SMALL", "target_support": 0.05, "beta": 0.18, "role": "primary_small_sparse_edge"},
    {"id": "TINY_NOISY", "target_support": 0.025, "beta": 0.12, "role": "stress_detection_floor"},
    {"id": "NONSTATIONARY_TRAP", "target_support": 0.10, "beta_by_era": {"E1": 0.30, "E2": 0.30, "E3": 0.00, "E4": -0.30, "E5": -0.30}, "role": "stability_negative_control"}
  ],
  "monte_carlo": {
    "worlds_per_primary_scenario": 200,
    "small_worlds_per_extra_sample_size": 200,
    "planned_total_worlds": 1600,
    "failed_world_denominator_policy": "failed worlds remain in denominator and make aggregate calibration INCOMPLETE_EXECUTION unless entire exact planned run is reproduced under same frozen code identity before result opening"
