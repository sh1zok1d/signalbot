    "open_ended_feature_search": false,
    "threshold_search": false,
    "post_result_candidate_addition": false
  },
  "forecast": {
    "baseline": ["intercept", "X1", "X2"],
    "candidate": ["intercept", "X1", "X2", "Fj"],
    "estimator": "numpy.linalg.lstsq(X,y,rcond=None)",
    "unweighted": true,
    "regularization": "none",
    "full_rank_required": true,
    "finite_coefficients_required": true,
    "pseudoinverse_fallback": false,
    "column_drop_fallback": false,
    "same_scoring_support": true
  },
  "chronology": {
    "E1": "training_only",
    "E2": "fit_E1_score_E2",
    "E3": "fit_E1_E2_score_E3",
    "E4": "fit_E1_E2_E3_score_E4",
    "E5": "fit_E1_E2_E3_E4_score_E5",
    "random_split_forbidden": true,
    "future_information_forbidden": true
  },
  "metrics": {
    "BASE_AE": "abs(Y-BASE_PRED)",
    "CAND_AE": "abs(Y-CAND_PRED)",
    "AE_IMPROVEMENT": "BASE_AE-CAND_AE",
    "MEAN_AE_IMPROVEMENT": "mean(AE_IMPROVEMENT)",
    "RELATIVE_MAE_IMPROVEMENT": "1-mean(CAND_AE)/mean(BASE_AE)"
  },
  "strict_reference_gate": {
    "gate_order": ["primary_positive", "material_relative_mae", "bootstrap_positive", "placebo_separation", "era_stability", "support_sanity"],
    "primary_positive": "MEAN_AE_IMPROVEMENT > 0",
    "material_relative_mae": "RELATIVE_MAE_IMPROVEMENT >= 0.02",
