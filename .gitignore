# Secrets
.env
.env.*
!.env.example
*.pem
*.key
# rclone remote credentials belong in /etc/signalbot or ~/.config/rclone on
# the VPS (see docs/DATA_DURABILITY_RUNBOOK.md), never in this repo — ignored
# defensively in case one is ever dropped into a working tree by mistake.
rclone.conf
backup.env

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Runtime / local research data (backups/ = local DB backups from deploy/backup.sh)
logs/
data/
backups/
artifacts/
# Owner-run live-archive coverage exports. Do not commit them.
live_archive_replay_preflight_coverage/
# Tardis free-sample vendor bytes for scripts/audit/tardis_free_overlap_v0.
# Inventory reports live under docs/audit/tardis_free_overlap_v0/. Do not commit
# the downloaded csv.gz files.
# D13 per-symbol ListBucket XML is acquisition runtime under artifacts/,
# not a tracked scientific authority. Do not commit docs/.../listings/per_symbol_1d/.
*.log
soak-test-*.log
soak-test-*.meta
# SQLite/DB sidecar files. Sealed journals are tracked as *.sqlite; their
# -journal/-wal/-shm sidecars are transient and never evidence.
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal
# Local exports / generated data dropped at the repository root only.
# Tracked research fixtures under docs/ (csv, zip, gz, sqlite) are unaffected.
/exports/
/*.csv
/*.parquet
/*.sqlite
/*.db

# OS / IDE
.DS_Store
.vscode/
.idea/

# MARKET-06 canonical execution runtime (local, never committed)
.market_06_canonical_execution.lock
.market_06_canonical_execution_attempts.json
BUILD_SHA
