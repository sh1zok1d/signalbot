# Copy this file to .env and fill in real values. .env is gitignored — NEVER
# commit real secrets. Recommended ownership/permissions on a VPS:
#   sudo chown root:signalbot .env && sudo chmod 640 .env
# (root can edit, the signalbot service can read via its group, others cannot.)

# --- PostgreSQL / TimescaleDB (loopback only; container from docker-compose) ---
# The bot builds the connection from these components and URL-encodes the
# password safely, so special characters are fine. docker compose reads the
# SAME POSTGRES_* variables — one source of truth, no duplicated password.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=btcbot
POSTGRES_DB=btcbot
# CHANGE THIS on a VPS to a strong random value, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=btcbot_change_me

# Optional: an explicit DSN overrides the components above. If you use it, YOU
# must percent-encode any special characters in the password. Leave unset to use
# the components (recommended).
# POSTGRES_DSN=postgresql://btcbot:btcbot_change_me@127.0.0.1:5432/btcbot

# --- Redis (loopback only) ---
# REQUIRED for every `main.py` command, including the private beta `--beta-*`
# commands (the shared secrets loader validates it), even though the beta itself
# never connects to Redis. Stage-1 ingestion does use it.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Telegram (used ONLY by the isolated shadow-forecast notifier; see
# docs/TELEGRAM_NOTIFIER_DEPLOY.md. Not used for trading, not used by Stage 1
# ingestion, not used by the shadow forecast/outcome pass itself — leave blank
# unless you are deploying the `--telegram-*` notifier commands/timer.) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Private beta V0.2 (docs/PRIVATE_BETA_V0_DEPLOY.md) ---
# Boolean flags accept 1/0, true/false. Leave a flag empty to use the default.
# BETA_ENABLED: an explicit value wins over config/beta_v0.yaml `beta.enabled`
#   (committed false); empty = use the committed config.
BETA_ENABLED=
# Restrict-only kill switches (empty = on, when beta is enabled).
BETA_DETECTION_ENABLED=
BETA_OUTCOME_TRACKING_ENABLED=
# Push additionally requires the committed `push_enabled: true`; keep empty/0.
BETA_PUSH_ENABLED=
# 0 = intentional no-Telegram shadow soak (no bot, no notifier, no Telegram
#   health checks). Refused while push is enabled or a bot token is set.
BETA_TELEGRAM_ENABLED=
# Beta bot (separate from the legacy TELEGRAM_BOT_TOKEN). Leave empty for the
# no-Telegram shadow soak.
BETA_TELEGRAM_BOT_TOKEN=
BETA_OWNER_TELEGRAM_USER_ID=
# Optional explicit beta code version (default: resolved from git history; set
# it when deploying without a .git directory).
BETA_CODE_VERSION=

# --- Off-site database backup (deploy/sync_backup_offsite.sh) ---
# Deliberately NOT configured here. SIGNALBOT_BACKUP_REMOTE and the
# SIGNALBOT_BACKUP_{DAILY,WEEKLY,MONTHLY}_RETENTION variables belong in a
# separate, root-only /etc/signalbot/backup.env — OUTSIDE this repository
# and outside this file (which is group-readable by the unprivileged
# signalbot user; the backup path intentionally is not). See
# docs/DATA_DURABILITY_RUNBOOK.md for the full setup.
