[Unit]
Description=Signalbot paired shadow W_L1 snapshot one-shot (not enabled by install)
Documentation=file:/opt/signalbot/docs/PAIRED_SHADOW_PRODUCTION_PREFLIGHT_V1.md
# Reads the same history grid as the V1 nightly build and writes a coefficient
# file. It does not insert beta_hist_stats and it does not start the history unit.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=signalbot
Group=signalbot
WorkingDirectory=/opt/signalbot
EnvironmentFile=/opt/signalbot/.env.paired-shadow
Environment=SIGNALBOT_DOTENV=0
InaccessiblePaths=-/opt/signalbot/.env
# StateDirectory is /var/lib/signalbot/paired-shadow and is the only tree
# ProtectSystem=strict leaves writable. The snapshot files are a subdirectory of it.
StateDirectory=signalbot/paired-shadow
ReadWritePaths=/var/lib/signalbot/paired-shadow
Environment=PAIRED_SHADOW_SNAPSHOT_DIR=/var/lib/signalbot/paired-shadow/snapshots
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/test -x /opt/signalbot/.venv/bin/python
ExecStartPre=/opt/signalbot/.venv/bin/python /opt/signalbot/deploy/wait_for_paired_shadow.py --timeout 60
ExecStart=/opt/signalbot/.venv/bin/python /opt/signalbot/scripts/beta/fit_paired_shadow_snapshot.py
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
SyslogIdentifier=signalbot-paired-shadow-snapshot

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
