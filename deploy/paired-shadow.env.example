# Host-only connection file for the paired shadow units.
# Install as /opt/signalbot/.env.paired-shadow, owner signalbot, mode 0600.
# Do not commit a real URL. The units refuse to take this URL as an argument.
# Create it with scripts/beta/write_paired_shadow_env.py so the shell history
# does not contain the password.
PAIRED_SHADOW_DSN=
