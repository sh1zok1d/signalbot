[Unit]
Description=Run Signalbot database backup + off-site sync once per day
Documentation=file:/opt/signalbot/docs/DATA_DURABILITY_RUNBOOK.md

[Timer]
# Once daily, UTC. 03:15 is arbitrary (off-hours for the primary BTCUSDT
# market, no significance beyond "not exactly midnight").
OnCalendar=*-*-* 03:15:00 UTC
AccuracySec=1min
RandomizedDelaySec=0
# A missed run (VPS briefly offline at 03:15 UTC) fires ONE catch-up run on
# return — this is the durability-relevant case: a day with no attempted
# backup must not silently become a day with no backup at all.
Persistent=true
Unit=signalbot-backup.service

[Install]
WantedBy=timers.target
