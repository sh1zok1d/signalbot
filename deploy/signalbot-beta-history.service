[Unit]
Description=Signalbot private beta decision-support history sync and statistics build one-shot
Documentation=file:/opt/signalbot/docs/PRIVATE_BETA_V0_DEPLOY.md
# PRODUCT_DECISION_V2: Binance Vision history (data.binance.vision) + nightly statistics.
# Ordering only — independent of Stage 1 ingestion and of every other beta unit.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=signalbot
Group=signalbot
WorkingDirectory=/opt/signalbot
# .env holds the DB password and the BETA_* kill switches. Never printed.
EnvironmentFile=/opt/signalbot/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/test -x /opt/signalbot/.venv/bin/python
ExecStartPre=/usr/bin/test -r /opt/signalbot/.env
ExecStartPre=/usr/bin/test -f /opt/signalbot/main.py
ExecStartPre=/opt/signalbot/.venv/bin/python /opt/signalbot/deploy/wait_for_infra.py --postgres-only --timeout 60
# 1) fetch the objects the ledger does not hold yet (resumable; a few objects a night)
ExecStart=/opt/signalbot/.venv/bin/python /opt/signalbot/main.py --beta-history-sync --beta-json --log-level INFO
# 2) rebuild the statistics from the stored history (appends one beta_hist_stats row)
ExecStart=/opt/signalbot/.venv/bin/python /opt/signalbot/main.py --beta-history-build --beta-json --log-level INFO
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
SyslogIdentifier=signalbot-beta-history

# --- Hardening (same audited profile as deploy/signalbot-telegram.service) ---
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

# No [Install] section: signalbot-beta-history.timer owns activation.
