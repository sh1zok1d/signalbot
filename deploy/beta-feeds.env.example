# /opt/signalbot/.env.beta-feeds — environment of signalbot-beta-feeds / signalbot-beta-stress ONLY.
# Written by deploy/install_beta_feeds_role.sh --set-password (root:root 0600; systemd reads it).
# Never commit the real file (.gitignore: .env.*). It must hold only the feed role's credentials:
# no Telegram token, no owner id, no push switch, no core DB password, no POSTGRES_DSN.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=btcbot
POSTGRES_USER=signalbot_beta_feeds
POSTGRES_PASSWORD=change_me_generated_by_install_beta_feeds_role
# same value as in /opt/signalbot/.env (the beta kill switch; unset = committed beta.enabled)
BETA_ENABLED=true
# Set by the units themselves, not here: SIGNALBOT_DOTENV=0, REDIS_URL (unused placeholder),
# BETA_FEEDS_EXPECTED_DB_ROLE=signalbot_beta_feeds.
