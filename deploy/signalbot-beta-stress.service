[Unit]
Description=Signalbot private beta research-evidence stress hours (public aggTrades of both venues) one-shot
Documentation=file:/opt/signalbot/docs/research/RESEARCH_EVIDENCE_INTEGRATION_V1.md
# Owner task 2026-10-04 (research evidence integration): public market data only (no exchange key,
# no account or order endpoint). Ordering only — independent of Stage 1 ingestion and of every
# other beta unit; it never requires, starts, stops or restarts any of them.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=signalbot
Group=signalbot
WorkingDirectory=/opt/signalbot
# Isolated credentials (docs/RESEARCH_EVIDENCE_DEPLOY_PLAN_V1.md §A, PREREQ-3): only the feed
# role's env file (deploy/beta-feeds.env.example; root:root 0600, read by systemd). A missing file
# fails the unit; there is no fallback to the core .env or the core DB role.
EnvironmentFile=/opt/signalbot/.env.beta-feeds
# The shared .env (Telegram, owner, core DB secrets) never reaches this process: no dotenv load,
# and the file is not even visible in this unit's mount namespace.
Environment=SIGNALBOT_DOTENV=0
InaccessiblePaths=-/opt/signalbot/.env
# The DB role this job must run as: another connected role is refused (WRONG_DB_ROLE, exit 3).
Environment=BETA_FEEDS_EXPECTED_DB_ROLE=signalbot_beta_feeds
# load_secrets() requires REDIS_URL; beta commands never connect to Redis (.invalid never resolves).
Environment=REDIS_URL=redis://unused.invalid:6379/0
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/test -x /opt/signalbot/.venv/bin/python
ExecStartPre=/usr/bin/test -f /opt/signalbot/main.py
ExecStartPre=/opt/signalbot/.venv/bin/python /opt/signalbot/deploy/wait_for_infra.py --postgres-only --timeout 60
ExecStart=/opt/signalbot/.venv/bin/python /opt/signalbot/main.py --beta-stress-once --beta-json --log-level INFO
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
SyslogIdentifier=signalbot-beta-stress

# --- Hardening (same audited profile as deploy/signalbot-telegram.service) ---
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

# No [Install] section: signalbot-beta-stress.timer owns activation.
