# QA / test environment template. Copy to .env.test (gitignored) — qa-bootstrap
# does this for you. NEVER put real secrets or production values here: this file
# points ONLY at the local test TimescaleDB/Redis from docker-compose.test.yml
# (loopback ports 5433 / 6380), which are separate from the production stack on
# 5432 / 6379. QA commands export SIGNALBOT_ENV_FILE=.env.test so the app loads
# this file instead of the production .env.

# --- Test PostgreSQL / TimescaleDB (loopback only, port 5433) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=signalbot_test
POSTGRES_DB=signalbot_test
POSTGRES_PASSWORD=signalbot_test

# --- Test Redis (loopback only, port 6380, db 0) ---
REDIS_URL=redis://127.0.0.1:6380/0

# --- Telegram: intentionally blank — the QA suite never talks to Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- QA guards ---
SIGNALBOT_ENV=test
ALLOW_EXTERNAL_NETWORK=false
